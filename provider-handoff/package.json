{
  "name": "@local/dsh-provider-handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Condense a long conversation with the wide-context model before the first request reaches a narrower one.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "budget.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
